{
  "sub2api_base_url": {"type": "string", "default": "http://127.0.0.1:8080", "description": "Sub2API 管理地址"},
  "sub2api_admin_api_key": {"type": "string", "default": "", "description": "运行时注入的管理员 API Key"},
  "sub2api_jwt": {"type": "string", "default": "", "description": "运行时注入的管理员 JWT"},
  "mode": {"type": "string", "enum": ["observe", "confirm", "auto"], "default": "confirm"},
  "poll_interval_seconds": {"type": "integer", "default": 60, "minimum": 10},
  "min_samples": {"type": "integer", "default": 10, "minimum": 1},
  "baseline_ms": {"type": "number", "default": 2000, "minimum": 1},
  "max_priority_penalty": {"type": "integer", "default": 10, "minimum": 0},
  "start_date": {"type": "string", "default": "", "description": "可选，YYYY-MM-DD"},
  "notify_platform": {"type": "string", "default": ""},
  "notify_target_id": {"type": "string", "default": ""},
  "ai_enabled": {"type": "boolean", "default": false},
  "ai_provider_id": {"type": "string", "default": ""},
  "admin_ids": {"type": "array", "items": {"type": "string"}, "default": []}
}
