# 复制为 dev.env 后使用。dev.env 包含本地开发凭据，禁止提交到 Git。
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_PASSWORD=replace-with-the-same-postgres-value
REDIS_PASSWORD=replace-with-a-random-value
REDISCLI_AUTH=replace-with-the-same-redis-value
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=replace-with-a-random-value
JWT_SECRET=replace-with-a-random-64-character-hex-value
TOTP_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-value
