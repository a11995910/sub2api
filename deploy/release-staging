#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  printf '%s\n' 'release-staging 必须由 root 手工执行。' >&2
  exit 1
fi

if [[ $# -lt 1 || $# -gt 3 ]]; then
  printf '用法：%s <target-commit> [staging-run-id] [--bootstrap-without-prod|--bootstrap-isolated-prod]\n' "$0" >&2
  exit 2
fi

target_commit="$1"
staging_run_id="$(date -u +%Y%m%d%H%M%S)"
bootstrap_without_prod=0
bootstrap_isolated_prod=0
case "${2:-}" in
  '')
    ;;
  --bootstrap-without-prod)
    bootstrap_without_prod=1
    ;;
  --bootstrap-isolated-prod)
    bootstrap_isolated_prod=1
    ;;
  *)
    staging_run_id="$2"
    ;;
esac
if [[ $# -eq 3 ]]; then
  [[ "$2" != --bootstrap-without-prod && "$2" != --bootstrap-isolated-prod ]]
  [[ "$3" == --bootstrap-without-prod ]]
  bootstrap_without_prod=1
fi
repo_dir=/opt/sub2api/repo
env_file=/opt/sub2api/env/staging/.env
base_compose="$repo_dir/deploy/docker-compose.yml"
staging_override=/opt/sub2api/compose/staging/docker-compose.yml
prod_env_file=/opt/sub2api/env/prod/.env
prod_override=/opt/sub2api/compose/prod/docker-compose.yml
prod_data_dir=/opt/sub2api/data/prod
state_dir=/opt/sub2api/state
staging_result="$state_dir/staging-result.json"
staging_public_url=http://185.61.210.32:18080
release_gates="$repo_dir/deploy/release-gates"
update_image=/opt/sub2api/scripts/update-sub2api-image

[[ "$target_commit" =~ ^[0-9a-f]{40}$ ]]
[[ "$staging_run_id" =~ ^[0-9]+$ ]]
test -d "$repo_dir"
test -f "$env_file"
test -f "$base_compose"
test -f "$staging_override"
test -x "$release_gates"
test -x "$update_image"
command -v flock >/dev/null
command -v jq >/dev/null
install -d -o root -g root -m 0755 "$state_dir"

commit="$target_commit"
short_commit="${target_commit:0:12}"
commit_date=""
target_image="sub2api:staging-$short_commit"
result_status=failed
result_tmp="$(mktemp "$state_dir/.staging-result.XXXXXX")"

compose_staging() {
  docker compose -p sub2api-staging \
    --env-file "$env_file" \
    -f "$base_compose" \
    -f "$staging_override" "$@"
}

compose_prod() {
  docker compose -p sub2api-prod \
    --env-file "$prod_env_file" \
    -f "$base_compose" \
    -f "$prod_override" "$@"
}

record_result() {
  local rc="$?" recorded_status=failed
  trap - EXIT
  set +e
  if [[ "$rc" -eq 0 && "$result_status" == verified ]]; then
    recorded_status=verified
  fi
  python3 - "$result_tmp" "$recorded_status" "$staging_run_id" "$commit" \
    "$short_commit" "$commit_date" "$target_image" "$bootstrap_without_prod" "$bootstrap_isolated_prod" "$staging_public_url" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, status, run_id, commit, short_commit, commit_date, image, bootstrap_raw, isolated_raw, public_url = sys.argv[1:]
payload = {
    "environment": "staging",
    "status": status,
    "workflow": "manual",
    "bootstrap_without_prod": bootstrap_raw == "1",
    "bootstrap_isolated_prod": isolated_raw == "1",
    "run_id": run_id,
    "commit": commit,
    "short_commit": short_commit,
    "date": commit_date,
    "image": image,
    "public_url": public_url,
    "verified_at": datetime.now(timezone.utc).isoformat(),
}
with open(path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
PY
  if ! install -o root -g root -m 0644 "$result_tmp" "$staging_result"; then
    printf '%s\n' '无法写入 staging 验证结果。' >&2
    [[ "$rc" -ne 0 ]] || rc=1
  fi
  rm -f -- "$result_tmp"
  if [[ "$rc" -ne 0 ]]; then
    compose_staging logs --tail=200 sub2api >&2 || true
    printf 'staging 发布失败：commit=%s run_id=%s\n' "$target_commit" "$staging_run_id" >&2
  else
    printf 'staging 验证通过：commit=%s image=%s run_id=%s\n' \
      "$commit" "$target_image" "$staging_run_id"
  fi
  exit "$rc"
}
trap record_result EXIT

build_resources="$("$release_gates" check-build-resources "$repo_dir")"
IFS='|' read -r build_gomaxprocs available_disk_kb total_mem_kb available_mem_kb cpu_count cpu_usage_percent <<< "$build_resources"

prod_status=healthy
if [[ "$bootstrap_without_prod" -eq 1 ]]; then
  [[ ! -e "$prod_env_file" && ! -L "$prod_env_file" ]]
  [[ ! -e "$prod_override" && ! -L "$prod_override" ]]
  test -z "$(docker ps -aq --filter label=com.docker.compose.project=sub2api-prod)"
  test -z "$(docker network ls -q --filter label=com.docker.compose.project=sub2api-prod)"
  test -z "$(docker volume ls -q --filter label=com.docker.compose.project=sub2api-prod)"
  for prod_container in sub2api-prod sub2api-prod-postgres sub2api-prod-redis; do
    ! docker container inspect "$prod_container" >/dev/null 2>&1
  done
  test ! -L "$prod_data_dir"
  if [[ -d "$prod_data_dir" ]]; then
    test -z "$(find "$prod_data_dir" -type f -print -quit)"
  fi
  prod_status=bootstrap-absent
  printf '%s\n' 'staging bootstrap 门禁：已确认目标主机不存在 prod 配置、容器或数据文件。'
elif [[ "$bootstrap_isolated_prod" -eq 1 ]]; then
  # 迁移验收只恢复了隔离数据库、尚无应用时，允许重新验证发布脚本修订。
  test -f "$prod_env_file"
  test -f "$prod_override"
  test -z "$(compose_prod ps -aq sub2api)"
  compose_prod config --format json | python3 -c '
import json, sys
c = json.load(sys.stdin)
for service in c["services"].values():
    networks = service.get("networks", {})
    assert networks and all(c["networks"][n].get("internal") is True for n in networks)
    assert not service.get("network_mode")
'
  prod_status=bootstrap-isolated-database-only
else
  test -f "$prod_env_file"
  test -f "$prod_override"
  prod_id="$(compose_prod ps -q sub2api)"
  test -n "$prod_id"
  test "$(docker inspect --format '{{.State.Status}}' "$prod_id")" = running
  test "$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$prod_id")" = healthy
fi

printf 'staging 资源检查：磁盘=%sGiB 内存=%sMiB/%sMiB CPU=%s GOMAXPROCS=%s CPU使用率=%s%% prod=%s\n' \
  "$((available_disk_kb / 1024 / 1024))" "$((available_mem_kb / 1024))" "$((total_mem_kb / 1024))" \
  "$cpu_count" "$build_gomaxprocs" "$cpu_usage_percent" "$prod_status"

cd "$repo_dir"
test -z "$(git status --porcelain)"
git fetch origin
git switch main
git pull --ff-only origin main
test "$(git rev-parse HEAD)" = "$target_commit"

commit="$(git rev-parse HEAD)"
short_commit="$(git rev-parse --short=12 HEAD)"
commit_date="$(git show -s --format=%cI HEAD)"
target_image="sub2api:staging-$short_commit"

exec 9>/var/lock/sub2api-build.lock
flock -n 9
docker buildx build \
  -f deploy/Dockerfile \
  --build-arg COMMIT="$short_commit" \
  --build-arg DATE="$commit_date" \
  --build-arg GOMAXPROCS="$build_gomaxprocs" \
  -t "$target_image" \
  --load .
flock -u 9

version_output="$(docker run --rm "$target_image" --version)"
printf '%s\n' "$version_output"
test "$(printf '%s\n' "$version_output" | grep -F "commit: $short_commit" | wc -l)" -eq 1

"$update_image" "$env_file" "$target_image" staging
compose_staging config -q
resolved_images="$(compose_staging config --images)"
test "$(printf '%s\n' "$resolved_images" | grep -Fxc "$target_image" || true)" -eq 1
compose_staging up -d
container_id="$(compose_staging ps -q sub2api)"
test -n "$container_id"
test "$(docker inspect --format '{{.Config.Image}}' "$container_id")" = "$target_image"
compose_staging ps
"$release_gates" wait-container-healthy "$container_id" 300 2
"$release_gates" wait-http http://127.0.0.1:18080/health 10 1
expected_version="$(tr -d '[:space:]' < "$repo_dir/backend/cmd/server/VERSION")"
test "$(curl -fsS http://127.0.0.1:18080/api/v1/settings/public | jq -r '.data.version')" = "$expected_version"
curl -fsS http://127.0.0.1:18080/ | grep -Fq "\"version\":\"$expected_version\""
# 公网入口必须提供同一套页面资源，避免容器健康但用户访问了旧站或正式站。
python3 - "$staging_public_url" "$expected_version" <<'PY'
import json
import sys
import urllib.request
from html.parser import HTMLParser

public_url, expected_version = sys.argv[1:]
local_url = "http://127.0.0.1:18080"

def fetch(base, path):
    with urllib.request.urlopen(base + path, timeout=30) as response:
        assert response.status == 200, "预发布入口返回非 200"
        assert response.geturl() == base + path, "预发布入口不应跳转到其他地址"
        if base == public_url:
            assert response.headers.get("X-Sub2API-Environment") == "staging", "缺少 staging 入口标识"
        return response.read()

class EntryScripts(HTMLParser):
    def __init__(self):
        super().__init__()
        self.sources = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "script" and attrs.get("type") == "module" and attrs.get("src"):
            self.sources.append(attrs["src"])

assert json.loads(fetch(public_url, "/health"))["status"] == "ok", "公网健康检查失败"
assert json.loads(fetch(public_url, "/api/v1/settings/public"))["data"]["version"] == expected_version, "公网版本不一致"
local_page, public_page = EntryScripts(), EntryScripts()
local_page.feed(fetch(local_url, "/").decode())
public_page.feed(fetch(public_url, "/admin/intelligent-ops/time-rotation").decode())
assert local_page.sources and local_page.sources == public_page.sources, "公网入口页面资源与 staging 不一致"
for path in local_page.sources:
    assert path.startswith("/assets/"), "页面入口资源路径异常"
    assert fetch(local_url, path) == fetch(public_url, path), "公网入口资源内容与 staging 不一致"
print("staging 公网 HTTP、健康、版本及页面资源验证通过：" + public_url)
PY
compose_staging logs --tail=200 sub2api

result_status=verified
