#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
用法：
  release-gates validate-backup-receipt <receipt> <target-commit> <staging-run-id> [now-epoch]
  release-gates print-backup-receipt <receipt>
  release-gates check-build-resources <repo-dir>
  release-gates wait-container-healthy <container-id> <timeout-seconds> <interval-seconds>
  release-gates wait-http <url> <timeout-seconds> <interval-seconds>
EOF
}

validate_backup_receipt() {
  if [[ $# -lt 3 || $# -gt 4 ]]; then
    usage >&2
    return 2
  fi
  local receipt="$1" target_commit="$2" staging_run_id="$3"
  local now_epoch="${4:-$(date -u +%s)}"
  local expected_owner_uid="${BACKUP_RECEIPT_OWNER_UID:-0}"

  python3 - "$receipt" "$target_commit" "$staging_run_id" "$now_epoch" "$expected_owner_uid" <<'PY'
import json
import os
import re
import stat
import sys
from datetime import datetime

path, target_commit, staging_run_id, now_epoch_raw, expected_owner_raw = sys.argv[1:]
if not re.fullmatch(r"[0-9a-f]{40}", target_commit):
    raise SystemExit("target commit format is invalid")
if not re.fullmatch(r"[0-9]+", staging_run_id):
    raise SystemExit("staging run id format is invalid")
try:
    now_epoch = int(now_epoch_raw)
    expected_owner = int(expected_owner_raw)
except ValueError as exc:
    raise SystemExit("numeric receipt validation argument is invalid") from exc

try:
    file_stat = os.lstat(path)
except FileNotFoundError as exc:
    raise SystemExit("backup receipt is missing") from exc
if not stat.S_ISREG(file_stat.st_mode) or stat.S_ISLNK(file_stat.st_mode):
    raise SystemExit("backup receipt must be a regular file")
if file_stat.st_uid != expected_owner:
    raise SystemExit("backup receipt owner mismatch")
if stat.S_IMODE(file_stat.st_mode) != 0o600:
    raise SystemExit("backup receipt mode must be 0600")

with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)

required = {
    "environment",
    "status",
    "target_commit",
    "staging_run_id",
    "backup_host",
    "archive",
    "sha256",
    "size_bytes",
    "toc_entries",
    "zstd_verified",
    "pg_restore_list_verified",
    "verified_at",
}
if not isinstance(payload, dict) or set(payload) != required:
    raise SystemExit("backup receipt fields mismatch")
if payload["environment"] != "prod-backup" or payload["status"] != "verified":
    raise SystemExit("backup receipt status mismatch")
if payload["target_commit"] != target_commit:
    raise SystemExit("backup receipt commit mismatch")
if str(payload["staging_run_id"]) != staging_run_id:
    raise SystemExit("backup receipt staging run mismatch")
if not re.fullmatch(r"[A-Za-z0-9._-]+", str(payload["backup_host"])):
    raise SystemExit("backup receipt host format is invalid")
if not re.fullmatch(r"sub2api-prod-[0-9]{8}T[0-9]{6}Z\.dump\.zst", str(payload["archive"])):
    raise SystemExit("backup receipt archive format is invalid")
if not re.fullmatch(r"[0-9a-f]{64}", str(payload["sha256"])):
    raise SystemExit("backup receipt sha256 format is invalid")
if isinstance(payload["size_bytes"], bool) or not isinstance(payload["size_bytes"], int) or payload["size_bytes"] <= 0:
    raise SystemExit("backup receipt size is invalid")
if isinstance(payload["toc_entries"], bool) or not isinstance(payload["toc_entries"], int) or payload["toc_entries"] < 100:
    raise SystemExit("backup receipt toc count is invalid")
if payload["zstd_verified"] is not True or payload["pg_restore_list_verified"] is not True:
    raise SystemExit("backup receipt archive verification is incomplete")

verified_at_raw = payload["verified_at"]
if not isinstance(verified_at_raw, str):
    raise SystemExit("backup receipt timestamp is invalid")
try:
    verified_at = datetime.fromisoformat(verified_at_raw.replace("Z", "+00:00"))
except ValueError as exc:
    raise SystemExit("backup receipt timestamp is invalid") from exc
if verified_at.tzinfo is None:
    raise SystemExit("backup receipt timestamp must include timezone")
age_seconds = now_epoch - int(verified_at.timestamp())
if age_seconds < 0 or age_seconds > 7200:
    raise SystemExit("backup receipt is expired or from the future")
PY
}

print_backup_receipt() {
  if [[ $# -ne 1 ]]; then
    usage >&2
    return 2
  fi
  local receipt="$1"
  python3 - "$receipt" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    payload = json.load(handle)
print(f"external_backup_receipt={path}")
print(f"external_backup_host={payload['backup_host']}")
print(f"external_backup_archive={payload['archive']}")
print(f"external_backup_sha256={payload['sha256']}")
print(f"external_backup_verified_at={payload['verified_at']}")
PY
}

check_build_resources() {
  if [[ $# -ne 1 ]]; then
    usage >&2
    return 2
  fi
  local repo_dir="$1"
  local min_disk_gib="${SUB2API_BUILD_MIN_DISK_GIB:-20}"
  local min_total_mem_gib="${SUB2API_BUILD_MIN_TOTAL_MEM_GIB:-12}"
  local min_available_mem_gib="${SUB2API_BUILD_MIN_AVAILABLE_MEM_GIB:-4}"
  local load_limit_percent="${SUB2API_BUILD_LOAD_LIMIT_PERCENT:-75}"
  local max_gomaxprocs="${SUB2API_BUILD_MAX_GOMAXPROCS:-8}"
  local meminfo_path="${SUB2API_BUILD_MEMINFO_PATH:-/proc/meminfo}"
  local loadavg_path="${SUB2API_BUILD_LOADAVG_PATH:-/proc/loadavg}"
  local available_disk_kb total_mem_kb available_mem_kb cpu_count load_one
  local build_gomaxprocs memory_limited_procs

  test -d "$repo_dir"
  [[ "$min_disk_gib" =~ ^[1-9][0-9]*$ ]]
  [[ "$min_total_mem_gib" =~ ^[1-9][0-9]*$ ]]
  [[ "$min_available_mem_gib" =~ ^[1-9][0-9]*$ ]]
  [[ "$load_limit_percent" =~ ^[1-9][0-9]?$|^100$ ]]
  [[ "$max_gomaxprocs" =~ ^[1-9][0-9]*$ ]]
  test -r "$meminfo_path"
  test -r "$loadavg_path"

  available_disk_kb="$(df -Pk "$repo_dir" | awk 'NR == 2 {print $4}')"
  total_mem_kb="$(awk '/MemTotal:/ {print $2; exit}' "$meminfo_path")"
  available_mem_kb="$(awk '/MemAvailable:/ {print $2; exit}' "$meminfo_path")"
  load_one="$(awk '{print $1}' "$loadavg_path")"
  cpu_count="${SUB2API_BUILD_CPU_COUNT:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc)}"

  [[ "$available_disk_kb" =~ ^[0-9]+$ ]]
  [[ "$total_mem_kb" =~ ^[0-9]+$ ]]
  [[ "$available_mem_kb" =~ ^[0-9]+$ ]]
  [[ "$cpu_count" =~ ^[1-9][0-9]*$ ]]
  [[ "$load_one" =~ ^[0-9]+([.][0-9]+)?$ ]]
  if ! (( available_disk_kb >= min_disk_gib * 1024 * 1024 )); then
    printf '构建资源不足：可用磁盘=%sKiB，最低要求=%sGiB\n' \
      "$available_disk_kb" "$min_disk_gib" >&2
    return 1
  fi
  if ! (( total_mem_kb >= min_total_mem_gib * 1024 * 1024 )); then
    printf '构建资源不足：总内存=%sKiB，最低要求=%sGiB\n' \
      "$total_mem_kb" "$min_total_mem_gib" >&2
    return 1
  fi
  if ! (( available_mem_kb >= min_available_mem_gib * 1024 * 1024 )); then
    printf '构建资源不足：可用内存=%sKiB，最低要求=%sGiB\n' \
      "$available_mem_kb" "$min_available_mem_gib" >&2
    return 1
  fi
  if ! awk -v load="$load_one" -v cpu="$cpu_count" -v limit="$load_limit_percent" \
    'BEGIN { exit !(load < cpu * limit / 100) }'; then
    printf '构建资源不足：一分钟负载=%s，CPU=%s，允许上限为 CPU 的 %s%%\n' \
      "$load_one" "$cpu_count" "$load_limit_percent" >&2
    return 1
  fi

  build_gomaxprocs="$cpu_count"
  (( build_gomaxprocs > max_gomaxprocs )) && build_gomaxprocs="$max_gomaxprocs"
  memory_limited_procs=$((available_mem_kb / (2 * 1024 * 1024)))
  (( build_gomaxprocs > memory_limited_procs )) && build_gomaxprocs="$memory_limited_procs"
  if [[ -n "${SUB2API_BUILD_GOMAXPROCS:-}" ]]; then
    [[ "$SUB2API_BUILD_GOMAXPROCS" =~ ^[1-9][0-9]*$ ]]
    build_gomaxprocs="$SUB2API_BUILD_GOMAXPROCS"
  fi
  if ! (( build_gomaxprocs >= 2 &&
    build_gomaxprocs <= cpu_count &&
    build_gomaxprocs <= max_gomaxprocs &&
    build_gomaxprocs <= memory_limited_procs )); then
    printf '构建并行度无效：GOMAXPROCS=%s，CPU=%s，内存上限=%s，配置上限=%s\n' \
      "$build_gomaxprocs" "$cpu_count" "$memory_limited_procs" "$max_gomaxprocs" >&2
    return 1
  fi

  printf '%s|%s|%s|%s|%s|%s\n' \
    "$build_gomaxprocs" "$available_disk_kb" "$total_mem_kb" "$available_mem_kb" "$cpu_count" "$load_one"
}

validate_wait_arguments() {
  local timeout_seconds="$1" interval_seconds="$2"
  [[ "$timeout_seconds" =~ ^[0-9]+$ ]]
  [[ "$interval_seconds" =~ ^[0-9]+$ ]]
  (( timeout_seconds > 0 ))
}

wait_container_healthy() {
  if [[ $# -ne 3 ]]; then
    usage >&2
    return 2
  fi
  local container_id="$1" timeout_seconds="$2" interval_seconds="$3"
  validate_wait_arguments "$timeout_seconds" "$interval_seconds"
  local started_at="$SECONDS" state

  while (( SECONDS - started_at <= timeout_seconds )); do
    if ! state="$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container_id")"; then
      printf '无法读取容器状态：%s\n' "$container_id" >&2
      return 1
    fi
    case "$state" in
      running\|healthy)
        return 0
        ;;
      *\|unhealthy|exited\|*|dead\|*|removing\|*)
        printf '容器未能健康启动：%s state=%s\n' "$container_id" "$state" >&2
        return 1
        ;;
    esac
    sleep "$interval_seconds"
  done

  printf '等待容器健康超时：%s timeout=%ss\n' "$container_id" "$timeout_seconds" >&2
  return 1
}

wait_http() {
  if [[ $# -ne 3 ]]; then
    usage >&2
    return 2
  fi
  local url="$1" timeout_seconds="$2" interval_seconds="$3"
  validate_wait_arguments "$timeout_seconds" "$interval_seconds"
  local started_at="$SECONDS"

  while (( SECONDS - started_at <= timeout_seconds )); do
    if curl --fail --silent --show-error --max-time 5 -o /dev/null "$url"; then
      return 0
    fi
    sleep "$interval_seconds"
  done

  printf '等待 HTTP 健康检查超时：%s timeout=%ss\n' "$url" "$timeout_seconds" >&2
  return 1
}

case "${1:-}" in
  validate-backup-receipt)
    shift
    validate_backup_receipt "$@"
    ;;
  print-backup-receipt)
    shift
    print_backup_receipt "$@"
    ;;
  check-build-resources)
    shift
    check_build_resources "$@"
    ;;
  wait-container-healthy)
    shift
    wait_container_healthy "$@"
    ;;
  wait-http)
    shift
    wait_http "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
